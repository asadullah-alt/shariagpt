UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenRouter (required)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=

# Qdrant Cloud (required)
QDRANT_URL=
QDRANT_API_KEY=

# Redis for session persistence (required for cross-restart persistence)
REDIS_URL=

# LlamaCloud (required for Admin PDF parsing)
LLAMA_CLOUD_API_KEY=

# Admin API Protection (required to secure /admin endpoints)
ADMIN_API_KEY=
# App settings (optional)
APP_VERSION=1.0.0
LOG_DIR=logs
TOP_K_CHUNKS=5
SESSION_TTL_SECONDS=86400

# Cloudinary configuration
CLOUDINARY_URL=
